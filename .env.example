# Supabase project settings > API. Publishable keys are safe in browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical local / deployed origin for OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only after the hosted Supabase Google provider is configured.
GOOGLE_OAUTH_ENABLED=false
# Server-only ESPN history import. Never prefix these with NEXT_PUBLIC_.
# Supabase project secret API key (sb_secret_...), or legacy service-role key.
SUPABASE_SECRET_KEY=
# Random secret used by Vercel's daily cron request.
CRON_SECRET=
# Your signed-in ESPN session: espn_s2 and SWID cookies. Store only as private secrets.
ESPN_S2=
ESPN_SWID=
